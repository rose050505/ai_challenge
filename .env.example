# ──────────────────────────────────────────────────────────────
# 서버 전용 환경변수 (Vercel Serverless Function 에서만 접근)
#
# ⚠️ VITE_ 접두사를 붙이면 클라이언트 번들에 그대로 노출된다.
#    API 키에는 절대 VITE_ 접두사를 사용하지 않는다.
# ──────────────────────────────────────────────────────────────

# Anthropic API 키. api/analyze.js 에서 process.env 로만 읽는다.
ANTHROPIC_API_KEY=

# 사용할 모델 (미설정 시 코드의 기본값 사용)
ANTHROPIC_MODEL=

# ──────────────────────────────────────────────────────────────
# 클라이언트 노출 환경변수 (VITE_ 접두사)
# 비밀값을 여기에 두지 않는다. 현재 사용 중인 항목 없음.
# ──────────────────────────────────────────────────────────────
